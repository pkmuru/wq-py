# Copy this file to ".env" and fill in your values.

# Work IQ MCP server endpoint
WORKIQ_MCP_URL=https://workiq.svc.cloud.microsoft/mcp

# --- Option 1: fixed token (for quick testing) -------------------------------
# If you paste a token here it is used for EVERY request and the
# On-Behalf-Of settings below are ignored. Leave it empty to use Option 2.
# Audience: api://workiq.svc.cloud.microsoft   Scope: WorkIQAgent.Ask
WORKIQ_ACCESS_TOKEN=

# --- Option 2: On-Behalf-Of (OBO) --------------------------------------------
# Callers send their own token (Authorization: Bearer <token>) and the app
# exchanges it for a Work IQ token. Values come from your Entra ID app registration.
TENANT_ID=your-tenant-id
CLIENT_ID=your-app-client-id
CLIENT_SECRET=your-app-client-secret
SCOPE=api://workiq.svc.cloud.microsoft/WorkIQAgent.Ask
